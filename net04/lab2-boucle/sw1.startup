# sw1 : pont Linux br0 sur eth0, eth1, eth2. STP est DESACTIVE (valeur par defaut) : la boucle n'est pas protegee.
ip link add br0 type bridge stp_state 0
ip link set eth0 master br0
ip link set eth1 master br0
ip link set eth2 master br0
ifconfig eth0 up
ifconfig eth1 up
ifconfig eth2 up
ifconfig br0 up
# activer STP : ip link set br0 type bridge stp_state 1   (bridge-utils : brctl stp br0 on)
