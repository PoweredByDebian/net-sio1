# sw1 : un commutateur (pont Linux br0) relie eth0, eth1 et eth2.
# net-tools ne sait pas creer de pont : on utilise iproute2 (equivalent bridge-utils en commentaire).
ip link add br0 type bridge
ip link set eth0 master br0
ip link set eth1 master br0
ip link set eth2 master br0
ifconfig eth0 up
ifconfig eth1 up
ifconfig eth2 up
ifconfig br0 up
# equivalent bridge-utils :
#   brctl addbr br0 ; brctl addif br0 eth0 ; brctl addif br0 eth1 ; brctl addif br0 eth2
#   ifconfig br0 up
