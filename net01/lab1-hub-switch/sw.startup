# sw : un pont Linux (br0) relie eth0, eth1 et eth2.
# net-tools ne sait pas creer de pont : on utilise iproute2 (equivalent bridge-utils en commentaire).
ip link add br0 type bridge
ip link set eth0 master br0
ip link set eth1 master br0
ip link set eth2 master br0

# ageing_time 0 : le pont n'apprend AUCUNE adresse MAC -> il repete tout partout, comme un CONCENTRATEUR
ip link set br0 type bridge ageing_time 0

ifconfig eth0 up
ifconfig eth1 up
ifconfig eth2 up
ifconfig br0 up

# equivalent bridge-utils :
#   brctl addbr br0
#   brctl addif br0 eth0 ; brctl addif br0 eth1 ; brctl addif br0 eth2
#   brctl setageing br0 0
#   ifconfig br0 up
