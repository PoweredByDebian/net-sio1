# r2 : eth0 192.168.2.254/24 (reseau local), eth1 10.0.12.2/30, eth2 10.0.23.1/30
ifconfig eth0 192.168.2.254 netmask 255.255.255.0 up
ifconfig eth1 10.0.12.2 netmask 255.255.255.252 up
ifconfig eth2 10.0.23.1 netmask 255.255.255.252 up
sysctl -w net.ipv4.ip_forward=1
# demarrer FRR (configuration dans etc/frr/ de ce dossier : RIP version 2)
systemctl start frr
# si systemctl n'existe pas dans l'image : /etc/init.d/frr start
