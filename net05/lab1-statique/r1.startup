# r1 : eth0 192.168.1.254/24 (reseau de pc1), eth1 10.0.12.1/30 (lien vers r2)
# AUCUNE route statique : c'est le travail du TP.
ifconfig eth0 192.168.1.254 netmask 255.255.255.0 up
ifconfig eth1 10.0.12.1 netmask 255.255.255.252 up
sysctl -w net.ipv4.ip_forward=1
# equivalent iproute2 : ip address add 192.168.1.254/24 dev eth0 ; ip address add 10.0.12.1/30 dev eth1 ; ip link set eth0 up ; ip link set eth1 up
